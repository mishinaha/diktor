+// ## 15.8 List と Option の Show
+//
+// `show` は組み込みの 6 型 (String / Boolean / Int32 / Int64 / Float64) にしか
+// 付いていませんでした。プレリュードが `List` と `Option` を宣言する以上、
+// その 2 つの `Show` もここが持ちます (P28 / D-K28)。前提つきインスタンス
+// (仕様 sample.kel:364-373) なので、要素が `Show` のときだけ効きます。
+//
+// 出力の形は `[1, 2, 3]` と `Some(1)` / `None` です。要素の区切りは `, ` で、
+// 空リストは `[]`。`Show[String]` は引用符を付けない恒等写像なので、
+// `show(Cons("a", Nil))` は `[a]` になります。
+//
+// 再帰はメソッド本体の中の `let rec go` が持ちます。インスタンス本体に
+// 書けるのはクラスのメソッドだけなので、補助関数をプレリュードの
+// トップレベルに置くと大域の名前が 1 つ増えます。ブロック内の `let rec` なら
+// 名前は漏れません。要素側の `show` を `Show.show` と修飾するのは、
+// 非修飾の `show` がこのメソッド自身に解決されうるためです。
+
+type instance[A: Show] Show[List[_]] {
+  let show(xs) = {
+    let rec go(ys) = ys match {
+      case Nil => ""
+      case Cons(head = h, tail = t) => t match {
+        case Nil => Show.show(h)
+        case _   => Show.show(h) + ", " + go(t)
+      }
+    }
+    "[" + go(xs) + "]"
+  }
+}
+
+type instance[A: Show] Show[Option[_]] {
+  let show(o) = o match {
+    case None    => "None"
+    case Some(x) => "Some(" + Show.show(x) + ")"
+  }
+}
