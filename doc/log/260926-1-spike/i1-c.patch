diff -ruN a/lib/exhaust.ml b/lib/exhaust.ml
--- a/lib/exhaust.ml
+++ b/lib/exhaust.ml
@@ -915,6 +915,23 @@
     all;
   !out
 
+(* 操作節の総和性の検査(第11章 §11.23)。rows は節ごとの引数パターンの列とガードの有無、
+   tys は操作の引数の型の列。行を閉じる操作はしない。
+   返り値は、ガードの無い節で覆えない値の例と、到達しない節の番号(0 始まり)*)
+let check_op_clauses (rows : (T.pat list * bool) list) (tys : ty list) =
+  let all = List.map (fun (ps, g) -> (List.map convert ps, g)) rows in
+  let unguarded_of l = List.filter_map (fun (r, g) -> if g then None else Some r) l in
+  let miss = missing (unguarded_of all) tys in
+  let dead =
+    List.concat
+      (List.mapi
+         (fun i (row, _) ->
+           let prior = List.filteri (fun j _ -> j < i) all in
+           if useful (unguarded_of prior) row tys then [] else [ i ])
+         all)
+  in
+  (miss, dead)
+
 let drain () =
   let entries = List.rev !pending in
   pending := [];
