+      lower_levels level p;
+      lower_levels level r;
+      lower_levels level e
+  | TRecord row | TVariant row -> lower_levels level row
+  | TRowEmpty -> ()
+  | TRowExtend (_, f, rest) ->
+      lower_levels level f;
+      lower_levels level rest
