#!/usr/bin/env keleut
// shebangはオプショナル
// コメント
/* コメント /* 入れ子にできる */ */
// * コメントの書式はMarkdownを奨励 *

// ============================================================
// 0. 括弧の役割
// ============================================================
// ()    グループ化、引数リスト、パラメータリスト、タプル
// {}    レコード、ブロック、matchの本体、handleの本体、エフェクト行、エフェクト宣言の本体
// #Foo  構造的ヴァリアントのコンストラクタ
// []    型パラメータリスト
//
// `#` は「構造的ヴァリアント」にだけ付ける。
// 名目コンストラクタと同じ構文位置を争うのはヴァリアントのラベルだけなので、
// 印が必要なのもそこだけである。印がなければ `Foo(x)` の意味が
// 「スコープに名目コンストラクタ Foo があるかどうか」で変わってしまう。
//
// --- `{` の読み分け（2トークン先読み） ---
//   `}`                                   → 空（Unit値 / 空レコード / 空タプル）
//   IDENT `=` / `,` / `with` / `extends`  → レコード
//   `extends`                             → レコード（行変数のみ）
//   IDENT `:`                             → レコード型
//   それ以外                               → ブロック
//   `@` の直後、EffectRow のエイリアスの右辺、effect 宣言の本体では先読みせず、エフェクト行 / 宣言本体と読む
//   `{x}` は IDENT `}` なのでブロック。単一フィールドのパンニングは `{x = x}` と書く。
//
// この規則は「代入演算子が存在しない」ことに依存している。
// 将来 `r.f = v` を足すとレコードとブロックの区別が壊れるので、入れないこと。
//
// --- `(` の読み分け（1トークン先読み） ---
//   型位置で `)` の直後が `=>`  → 関数型。そうでなければタプル型
//   式位置でトップレベルに `,`  → タプル。なければグループ化
//   呼び出し先の直後 / `fn` の直後 → 引数リスト・パラメータリスト
//
// --- 字句 ---
// ソースは UTF-8。先頭の BOM は許さない（字句エラー）。
// 改行は LF。文字列リテラルの外では CR を空白として扱う（CRLF が改行として働く）。文字列リテラルの中の CR はそのまま残る。
// カンマ区切りのリストは例外なく（引数、パラメータ、型引数、型パラメータ、レコード、タプル、パターン、
// エフェクト行、effect 宣言の操作、コンストラクタのフィールド、`F[_, _]` の穴）最後の要素の後に末尾カンマを置ける。
// `...rest` と `extends R` は要素ではなく終端子なので、その後には置けない。
// ただし `(e,)` は末尾カンマではなく 1 要素タプル（§4）と読む。タプルの末尾カンマは 2 要素以上で働く。
// 識別子は小文字始まり。大文字始まりは型名、コンストラクタ、エフェクト名、モジュール名に使う。

// ============================================================
// 1. 型エイリアス
// ============================================================

type MyInt = Int32
type Unit  = {}                      // 空レコード。`()` は同じものを指す

type Point = {x: Float64, y: Float64}
type Pair  = (Int32, String)

// 構造的ヴァリアント。`#` 付きのコンストラクタは大域的なラベルであって、
// どの型にも属さない（OCamlの多相ヴァリアントと同じ立場）
type Parity = #Even | #Odd

// エイリアスにはカインドを注釈できる。省略時は Type。
// カインド EffectRow のエイリアスを許すことで、エフェクト行に名前が付けられる
// （§9 の Request を参照）。新しい構文を足さずに、行の肥大化を抑えられる。
//
// 型エイリアスは非再帰に限る。
// 透過的なエイリアスの再帰は等再帰型へのコミットを意味し、
// ラベルの打ち間違いがエラーではなく無限型として現れるため。
// 再帰データは必ず newtype を通す。

// ============================================================
// 2. リテラル
// ============================================================

// 整数リテラルには「整数型でなければならない」という述語を持つ単一化変数が割り当てられる。
// 型クラスではない。組み込みの数値型だけがこの述語を満たし、ユーザには開かない。
//   - 単一化は普通に進む
//   - 一般化の時点で未解決なら既定値に落ちる（Integral → Int32、Fractional → Float64）
//   - この変数は一般化されない（束縛時に必ず具体化される）
// これにより defaulting 規則も単相性制限も不要になる。
let a = 0                            // Int32（未解決 → 既定値）
let b: Int64 = 0                     // Int64（注釈との単一化で決まる）
let c = 0i64                         // 接尾辞。曖昧性を切る明示手段として残す
let d = -1                           // 符号はリテラルの字句に含む（単項マイナスではない）
let e = 1.5                          // Float64
// let f = 0 + "x"                   // エラー: String は整数型ではない

// Integral / Fractional は型クラス制約と同じ制約集合に載る（インスタンスは上のとおりユーザに開かない）。
// 曖昧性検査（型から到達できない制約つきの型変数を拒む検査）は、この 2 つの述語だけ免除する。既定化で必ず決まるため。
// `Zero` / `One` のようなクラスは設けない（リテラルの述語で足りる）。
//
// 浮動小数リテラルは `1.5` / `1e5` / `1.5e-3` の形。指数部は `e` または `E` に符号つきの 10 進。
// 小数部は省略できる（`1.` は 1.0、`1.e5` は 1e5）。先頭小数点（`.5`）は許さない（`t._0` のような射影との読み分けのため）。
// 最長一致により `1._0` や `1.foo` は「数値 + 識別子」に読まれる。数値リテラルへの射影は書けないが、数値は行を持たないので失うものは無い。
// 非有限値（NaN、無限大）のリテラルは無い。
// Float64 の文字列化は、読み戻せば同じ値になる字面のうち最短のものを出す。小数点も指数も無い字面には `.0` を足す
// （`1` は整数リテラルで別の値になるため）。非有限値だけは例外で、`nan` / `inf` / `-inf` と綴る（符号つき NaN も `nan`）。
//
// 数値型どうしの暗黙変換は無い。明示変換のプリミティブは `__<元>_to_<先>` の形で、型名は `i32` / `i64` / `f64` と綴る
// （`__i32_to_i64`、`__i32_to_f64`、`__i64_to_i32`、`__i64_to_f64`、`__f64_to_i32`、`__f64_to_i64`。算術の `__int32_add` とは綴りが違う）。
// 浮動小数から整数への変換は、NaN と範囲外を実行時エラーにし、範囲内はゼロ方向に切り捨てる。
// Int64 から Int32 は wrap-around。整数算術の桁あふれも wrap-around（暫定。§14）。ゼロ除算は実行時エラー。
//
// 文字列リテラルは `"…"`。文字列は UTF-8 のバイト列であり、Char 型は無い。
// エスケープは `\n` `\t` `\r` `\a` `\b` `\f` `\v` `\\` `\"` `\'` と、`\uXXXX`（4 桁）`\UXXXXXXXX`（8 桁）の
// コードポイント指定。サロゲートと範囲外のコードポイントは字句エラー。生の改行を文字列に含めてよい。

// ============================================================
// 3. レコードと行多相（Scoped Labels）
// ============================================================

// 行変数は `extends` の右に書く。`{extends R}` は「行Rを持つレコード」
let sum_xy[R](p: {x: Float64, y: Float64 extends R}): Float64 =
  p.x + p.y                                   // 選択 `r.l`

let with_z[R](p: {extends R}): {z: Float64 extends R} =
  {z = 0.0 extends p}                         // 拡張 `{l = e extends r}`

let move_x[R](p: {x: Float64 extends R}, dx: Float64): {x: Float64 extends R} =
  {p with x = p.x + dx}                       // 更新 `{r with l = e}`
// 更新の基底 r は識別子 1 個に限る（§0 の `{` の読み分けが IDENT の直後の `with` だけを見るため）。
// `{p.origin with …}` や `{f(x) with …}` は書けない。基底を式にしたいときは let で束縛する。

// Scoped Labelなので、同じラベルは上書きされず「被さる」
// 制限は `r \ l`（`-` は減算と衝突するため使わない）
let outer_x(): Float64 = {
  let p = {x = 1.0 extends {x = 2.0, y = 3.0}}
  // pの型は {x: Float64, x: Float64, y: Float64}
  p.x                                         // => 1.0（外側）。`(p \ x).x` は 2.0（内側）
}

// パンニング。`{a, b}` は `{a = a, b = b}` の略記
let make_point(x: Float64, y: Float64): Point = {x, y}

// ============================================================
// 4. タプル（重複ラベルの糖衣）
// ============================================================

// タプルは「同じラベル `_item` を重ねたレコード」の糖衣である。
// Scoped Label が同一ラベルの順序だけを保存するという性質が、
// タプルの「位置が意味を持つ」という要求とそのまま一致する。
//
//   (A, B, C)  ≡  {_item: A, _item: B, _item: C}
//   (a, b, c)  ≡  {_item = a extends {_item = b extends {_item = c}}}
//   (a,)       ≡  {_item = a}                    1要素タプル
//   ()         ≡  {}                             空タプル = 空レコード = Unit
//
// cons と tail がレコード演算からそのまま出てくる（マクロ不要）。
//   cons  {_item = v extends t}
//   head  t._item
//   tail  t \ _item
//
// 位置アクセスは `t._0` `t._1` …。`t.0` としないのは `t.0.1` が
// 浮動小数点リテラルと字句衝突するため（Rustが実際に苦労した箇所）。
//   t._0 ≡ t._item
//   t._1 ≡ (t \ _item)._item
//
// ラベル名は `_item` で確定する。型とエラーメッセージの表示では、`_item` だけからなる閉じた行をタプルの字面に戻す
// （2 要素以上は `(A, B)`、1 要素は `(A,)`、空行は `{}` のまま）。
// 開いた行（`{_item: A extends R}`）はタプルではないので戻さず、`_item` がそのまま見える。
let swap[A, B](p: (A, B)): (B, A) = (p._1, p._0)

// 閉じた行なので arity は静的に検査される。
// `(A, B)` は行変数を持たないので 3-タプルとは単一化しない。

// 行変数を明示すれば「先頭が A であるような任意のタプル」を受けられる。
// 名目的なタプルでは書けない前置多相が手に入る。
let fst[A, R](t: {_item: A extends R}): A = t._item

// ただし arity についての再帰は書けない。
// 基底ケース（`{}`）と「行が空か」の分岐が要るが、構造的な型へのインスタンスを
// ユーザに書かせない方針の下では表現できない。cons と tail は「あるが回せない」。
//
// また `_item` は普通のラベルなので抽象は漏れる。
// `{x = 1, _item = "hi"}` は fst に通る。これは意図的に開いたままにする
// （字句的に禁じると cons が書けなくなり、この設計の利点が失われるため）。

// ============================================================
// 5. 構造的ヴァリアント
// ============================================================

// ヴァリアントも行多相。`| R` は「他のケースもありうる」
let describe[R](v: #Even | #Odd | R): String =
  v match {
    case #Even => "even"
    case #Odd  => "odd"
    case _     => "unknown"                   // 残りの行Rをまとめて受ける
  }

// ペイロードは常に単値。ラベルにarityが乗ると行の統一規則が複雑になるため。
// `#Foo(a, b)` は `#Foo((a, b))` の糖衣。式でもパターンでも成立する。
type IoError    = #NotFound(String) | #Denied(String)
type ParseError = #Syntax((Int32, Int32))

let report(e: IoError | ParseError): String =
  e match {
    case #NotFound(path)    => "not found: " + path
    case #Denied(path)      => "denied: " + path
    case #Syntax(line, col) => "syntax error"  // #Syntax((line, col)) と同じ
  }

// 構造的ヴァリアントは「開いた和の合成」に使う。
// 再帰させたい場合と型クラスを実装したい場合は newtype を使う。

// ============================================================
// 6. 名目的な型（newtype）
// ============================================================

// newtypeの右辺は「コンストラクタ宣言の並び」であって型式ではない。
// コンストラクタは多値を取れるので、包みが二重にならない。右辺全体をホール `???` にもできる（§13 の BigInt）。
newtype Option[A] = Some(A) | None
newtype List[A]   = Cons(head: A, tail: List[A]) | Nil
newtype Never                                 // コンストラクタを持たない型

// コンストラクタのフィールドは常に順序付き。ラベルは任意。
//   Some(A)                       … 無名。位置指定でのみ束縛できる
//   Cons(head: A, tail: List[A])  … ラベル付き。位置指定でも `Cons(tail = t)` でも書ける
// 混在してよい。
// 型パラメータのカインドは本体での使われ方から推論し、使われ方が無ければ Type。§9 の Callback[E] の E は矢印の `@` に現れるので EffectRow と決まる。

// 単一コンストラクタで型名と同名の場合の略記法
newtype UserId(Int32)                         // = newtype UserId = UserId(Int32)
newtype TotalFloat64(Float64)                 // §14 の Ord[Float64] の案 (1) を見越した名前。Ord を実装するかは未定

let some_one(): Option[Int32] = Some(1)

let get_or[A](v: Option[A], default: A): A =
  v match {
    case Some(x) => x
    case None    => default
  }

// ============================================================
// 7. 関数・束縛・ブロック
// ============================================================

// 関数は多値を取り単値を返す。arityは矢印型の一部である。
//   (Int32, Int32) => Int32  と  (Int32) => (Int32) => Int32  は別の型
// カリー化と部分適用は言語機能としては提供しない。
//
// 評価順序は左から右。引数リスト、レコードの各フィールド、matchのスクルティニ、
// すべて左から右。`{l = e extends r}` は e を先、r を最後に評価する。
// タプルの脱糖がこの規則に乗るので、(a, b, c) は a → b → c の順に評価される。
//
// 末尾式のないブロックの型は Unit。Unit値を明示的に書く場面はほとんどない。

// letは文。`in` は存在しない。ブロックの最後の式がブロックの値になる。
let list_length[A](xs: List[A]): Int32 = {
  // letで束縛する関数は型注釈を省略できる
  let rec aux(xs, n) = xs match {             // matchはScalaのように後置
    // 網羅性検査される
    case Nil           => n
    case Cons(_, tail) => aux(tail, n + 1)    // 位置指定パターン
  }
  aux(xs, 0)
}
; // トップレベル宣言を区切るセミコロンは必ず省略可能だが、
  // REPLやエディタの補完を制御するためにオプショナルでサポートされている
  // ただし行頭の `(` は前の行の継続とみなさない（改行が優先される）

let twice_sum_xy(p: Point): Float64 = {
  let doubled = {                             // ブロックは式
    let s = p.x + p.y
    s + s
  }
  doubled - p.x
}

// letはパターンで分解できる
let dist(p: Point): Float64 = {
  let {x, y} = p
  sqrt(x * x + y * y)
}

// タプルパターンは `...rest` で末尾を束縛できる（行の制限がパターンに現れる）
let head_and_rest[A, R](t: {_item: A extends R}): A = {
  let (x, ...rest) = t
  x
}

// 無名関数は `fn(x) => e`。
// `(x) => e` としないのは、式位置の `(` がタプルと衝突するため。
// `fn` があることで、パラメータリストとタプルが構文的に分かれる。
let inc_all(xs: List[Int32]): List[Int32] = map(xs, fn(n) => n + 1)

// ガード付きパターン `case P if cond => e`
// ガード付きのケースは網羅性検査で「必ずマッチする」とは数えられないので、
// 最後のケース（ガードなし）が必要
let rec count_if[A, E](xs: List[A], pred: (A) => Boolean @ E): Int32 @ E =
  xs match {
    case Nil                            => 0
    case Cons(head, tail) if pred(head) => 1 + count_if(tail, pred)
    case Cons(_, tail)                  => count_if(tail, pred)
  }

let rec is_even(n: Int32): Boolean =
  n match {
    case 0          => true
    case n if n < 0 => is_even(0 - n)
    case n          => is_odd(n - 1)
  }
and is_odd(n: Int32): Boolean =
  n match {
    case 0          => false
    case n if n < 0 => is_odd(0 - n)
    case n          => is_even(n - 1)
  }

// or パターン（`case #Even | #Odd =>`）は入れない。パターンの文法に `|` を出さなければ、
// 必要になってから足しても既存の文法と衝突しないため。
//
// 節の最上位に現れる `=>` は常に節の矢印である。将来 `case p: T => e` のようにパターンへ型注釈を
// 入れる場合、矢印を含む型注釈は括弧を必須にする（型がどこで終わるかを字句層が決められないため）。

// ============================================================
// 8. 型クラス
// ============================================================

// 1パラメータ型クラスとHKTをサポート。
// ランク2多相と多パラメータ型クラスは意図的に排除する。エフェクトと行多相で代用すること。
// コヒーレンスは堅持する（インスタンスは常に大域可視で、隠したり選び直したりできない）。
//
// ユーザー定義演算子は入れない。組み込みの演算子が標準ライブラリの型クラスを呼ぶ。
//   +  Add.add      -  Sub.sub      *  Mul.mul      /  Div.div
//   == Eq.eq        != Eq.eq の否定
//   <  Ord.lt       <= Ord.le       >  Ord.gt       >= Ord.ge
//   && || !         Boolean 組み込み（短絡するため型クラスにできない）
//   \               行の制限（組み込み構文）
//
// Num にまとめないのは、String のように `+` だけを持つ型があるため。
type class Add[A] { val add: (A, A) => A }
type class Mul[A] { val mul: (A, A) => A }

type instance Add[Int32]  { let add(x, y) = __int32_add(x, y) }
type instance Mul[Int32]  { let mul(x, y) = __int32_mul(x, y) }
type instance Add[String] { let add(x, y) = __string_concat(x, y) }

let fma[A: Add + Mul](x: A, y: A, z: A): A = x * y + z   // add(mul(x, y), z) に翻訳される

// --- 構造的な型へのインスタンス ---
//
// ユーザには書かせない。コヒーレンスを堅持するため、組み込みの自動導出のみが与える。
// 導出規則はクラス宣言に一つだけ付随させる。誰でも任意のクラスに導出を書けるようにすると、
// 二つのパッケージが同じ構造型に別の Eq を導出しうる。
type class Eq[A] {
  val eq: (A, A) => Boolean
  derive structural                           // 組み込みの構造的導出を有効にする
}

// 導出は閉じた行にのみ適用される。行変数を含む型は比較できない。
// （点ごとの行制約 `[R: Eq]` を入れれば可能だが、カインドと制約解決に手が入るので採らない）
let same_point(p: Point, q: Point): Boolean = p == q
let same_pair(p: Pair, q: Pair): Boolean = p == q         // タプルも閉じた行なのでOK
// let same[R](p: {x: Int32 extends R}, q: {x: Int32 extends R}) = p == q   // エラー
//
// `derive structural` を書けるのは、クラスパラメータのカインドが Type のクラスだけである。
// 構造的導出は行の各フィールドの型へ再帰する規則なので、Functor のように型引数を取るクラスには当てはめようがない。
// カインドで弾けるので、宣言の時点でエラーにする。

// --- スーパークラスと前提つきインスタンス ---
//
// スーパークラス（クラスパラメータへの制約 `type class Ord[A: Eq]`）は入れない。
// 制約の含意を持たないほうが、署名に書いた制約だけで解決が決まり単純だからである。
// Ord は Eq を含意しないので、両方が要る場面では `[A: Eq + Ord]` と並べて書く。
//
// 前提つきインスタンスは、型パラメータリストを `instance` の直後に書く。
// リストの型パラメータは、インスタンスの型に現れる `_` へ左から順に対応する（下の `Eq[List[_]]` の `_` が `[A: Eq]` の A）。
// 前提はインスタンスの選択にだけ使う。コヒーレンスにより選択は静的に一意なので、前提を値として渡す手段は無い。
type instance[A: Eq] Eq[List[_]] {
  let rec eq(xs, ys) = (xs, ys) match {
    case (Nil, Nil)                 => true
    case (Cons(x, xt), Cons(y, yt)) => x == y && eq(xt, yt)
    case _                          => false
  }
}

// --- エフェクト多相 ---
//
// 型クラスのメソッドの矢印にもエフェクト行を書く。
// 書かないと純粋な関数しか渡せず、高階関数が使い物にならない。
// 入れ子の矢印（メソッドの引数の型）で省略された `@` は `@ {}`（純粋）と読む（§9）。
// エフェクト多相にしたいときは、map のように行変数を型パラメータに取って明示する。
// メソッドの最外の矢印で省略された `@` は「どのインスタンスの実装も純粋でなければならず、公開される型は行多相」と読む（§9）。
type class Functor[F[_]] {
  val map[A, B, E]: (F[A], (A) => B @ E) => F[B] @ E
}

type instance Functor[List[_]] {
  let rec map[A, B, E](xs: List[A], f: (A) => B @ E): List[B] @ E =
    xs match {
      case Nil              => Nil
      case Cons(head, tail) => Cons(f(head), map(tail, f))
    }
}

// Monad / Applicative / Traversable はプレリュードに置かない。
//  - インスタンスがエフェクト中立を強いられる（内部でAsyncを使う型がMonadになれない）
//  - HKTの穴の位置とエフェクトの位置が衝突する
//  - モナドとエフェクトの解釈順が固定される
// エフェクト付き map が traverse を兼ねるので、Traversable は不要になる。
let user_names[E](xs: List[User]): List[String] @ {Print extends E} =
  map(xs, fn(u) => { println(u.id); u.name })

// ============================================================
// 9. エフェクト
// ============================================================

effect Print   = { print: (String) => Unit }
effect Console = { write: (String) => Unit }   // ランタイムが提供する低レベルなエフェクト
effect Fs      = {}                            // ランタイムが提供するファイル I/O のエフェクトラベル。操作を持たない

// `@` の右はエフェクト行。`@ Print` は `@ {Print}` の略記
// 複数なら `@ {Print, Console}`、行変数を含むなら `@ {Print extends E}`
// 空行 `@ {}` は「純粋」を意味する
//
// --- 注釈した行の読み方（位置で決まる） ---
//
// 行の部分型付け（サブエフェクティング）は無い。関数の行と呼び出し側の行は単一化で一致させる。
// そのため、注釈をどう読むかで書けるプログラムが変わる。
//
// 束縛（let / pub let / extern / 型クラスのメソッド）の最外の矢印にラベル付きの行を書いたときは、
// その行は本体に対する上限として働く。注釈に無いエフェクトを本体が起こせばエラーになる。
// 一方、公開される型では行変数で開かれるので、呼び出し側の行には他のエフェクトが載っていてよい。
// `@ Print` を「ちょうど Print」と読まないのはこのためで、閉じた行と読むと下の handle の例
// （`println("test") handle …`。本体の println が置かれる行は {Print, Console}）が型付かない。
// `@ {}` だけは両方向に効く。本体は純粋でなければならず、呼び出し側の行も空でなければならない。
// 行変数を含む行（`@ E`、`@ {Print extends E}`）は書いたとおりに多相で、これ以上開かれることはない。
//
// 最外の矢印で `@` を省略したときの意味：
//   let                 推論する。純粋な本体なら行変数として一般化され、どこからでも呼べる
//   pub let             本体は純粋でなければならず、公開される型は行多相（§13）
//   型クラスのメソッド   インスタンスの実装が純粋でなければならず、公開される型は行多相
//   extern              本体が無いので、公開される型が行多相になる
//
// 入れ子の矢印（最外以外のすべての矢印。引数の型や返り値の中の矢印、newtype のフィールド、effect の操作型の
// 引数に現れる矢印、型エイリアスが展開する矢印）に書いた行は書いたとおりに読み、行変数で開かない。
// `@` を省略したら `@ {}`（純粋）と読む。
// エフェクト付きの関数を受け取りたいときは、行変数を型パラメータに取って明示する
// （§8 の map、下の capture が見本）。省略された `@` を行変数として一般化すると、newtype のフィールドを経由して
// エフェクト付きのクロージャを純粋として取り出せてしまう。だから省略は純粋と読む。
newtype Callback[E] = Callback(() => Unit @ E)  // エフェクト付きのクロージャを持つ newtype はこう書く
let println(message: String): Unit @ Print = perform print(message + "\n")

// handleはエフェクトを別のエフェクトに翻訳したり、消したりする
// ケースはエフェクト名ではなく操作名で書く（曖昧なら `Print.print` と修飾できる）
// エフェクトの全操作を網羅する必要がある
//
// 操作名は英小文字で始める。`return` と `cancel` は handle の節の名前と衝突するので操作名にできない。
// 同じ操作名を複数のエフェクトが宣言してよい（上の Console.write と下の File.write）。
// 非修飾の操作名の解決規則は perform と handle で異なる：
//   perform  その操作名を宣言しているエフェクトを候補とする。候補が 1 つならそれに解決する（行に現れているかは問わない）。
//            候補が 2 つ以上なら、その位置のエフェクト行に現れる候補のうち最も左のものに解決する。
//            行に候補が 1 つも現れなければ修飾を要求する（推測しない）。左右は行に書かれた順序で決まる。
//            行が handle の入れ子から推論で組み立てられている限り、最左の候補は最内のハンドラのエフェクトになる。
//            行を注釈で明示したときは書いた順序がそのまま使われ、実行時の入れ子順とは食い違いうる。
//   handle   return 節と cancel 節を除く全節が非修飾のとき、スコープ内のエフェクトのうち
//            「全節の操作名を宣言しており、かつ自分の全操作がこの handle に書かれている」ものを候補とする。
//            候補が 0 個なら網羅漏れ、2 個以上なら修飾を要求する。
// エフェクト行の並びは注釈に書いた順と handle が積む順で決まり、操作名の解決にだけ使う。
// 型の等価性では異なるラベルの順序を問わない（§3 の Scoped Labels と同じ）。
// 下の copy の write は候補が File と Console の 2 つあり、with_file が積んだ File が左にあるので File.write に決まる。
// 同じエフェクトを二重に積むと、非修飾でも修飾でも内側にしか届かない。copy が src を読んでから dst を開くのはそのためである。
//
// ランタイムが実装を持つエフェクト（Console、Async、Fs）はユーザの handle の対象にできない。
// perform はできる。出力先を差し替えたいときは Print のような自前のエフェクトをハンドルする
// （下の capture が見本）。印は設けず、この 3 つを名前で定める。標準ライブラリが宣言していても、
// Fail や Nursery のように実装が言語の中にあるものはユーザがハンドルできる。
//
// resumeは継続。second-class であり、節の外へ持ち出せない
// （変数に束縛する、クロージャに閉じ込める、返り値にする、はいずれも不可）。
// これにより節を抜ける時点で継続の生死が確定し、下の自動巻き戻しが成立する。
// resumeはアフィン（高々一回）。操作の返り値型が Unit なら `resume()` と書ける。
println("test") handle {
  case print(message) => resume(perform write(message))
  case return(x) => x                         // 省略時は `case return(x) => x` と同じ
}
// この式の型は Unit @ Console （Printは消え、Consoleが残る）

// resumeの返り値はhandle式全体の型なので、出力を集めるハンドラも書ける
let capture[A, E](body: () => A @ {Print extends E}): {value: A, output: String} @ E =
  body() handle {
    case print(message) => {
      let {value, output} = resume()
      {value, output = message + output}
    }
    case return(x) => {value = x, output = ""}
  }

// --- 例外・後始末・キャンセル ---
//
// 専用の例外機構は持たない。resume を呼ばずに節を抜けると、
// 中断されたフラグメントは言語が自動で巻き戻す（後入れ先出し）。
effect Fail = { throw: (String) => Never }

let try_[A, E](body: () => A @ {Fail extends E}): #Ok(A) | #Err(String) @ E =
  body() handle {
    case throw(e)  => #Err(e)                 // resumeを呼ばない → 自動で巻き戻る
    case return(x) => #Ok(x)
  }

// defer構文は持たない。後始末はハンドラの `cancel` 節に書く。
// これによりLIFO順序・後始末の中で許されるエフェクト・deferとhandleの相互作用が
// すべて「ハンドラの入れ子」の規則に吸収される。
//
//   case return(x) => …  正常終了（省略時 x をそのまま返す）
//   case cancel    => …  外側が継続を捨てたことによる巻き戻し（省略時 何もしない）
//
// cancel節は自身の行から抜け出せない。例外相当を投げても抑制されてログに回る。
// cancel 節は、巻き戻しを起こしているハンドラが外れた文脈で走る（return 節も同じ）。型もそう読み、cancel 節はハンドラの外側の行で型付けされる。
// だから cancel 節から自分の操作を perform すると、自分の節ではなく外側の同名エフェクトのハンドラに届く。
// 届いた先が resume を呼ばずに抜けた場合、その巻き戻しは上の抑制規則の下に入り、ログに回るだけで外へは出ない。
// 将来 `case cancel(reason) =>` に拡張できるよう構文の余地を空けてある
// （Go が context.Cause を後から足したのと同じ需要がある）。
effect File = {
  read:  () => String,
  write: (String) => Unit,
}

// ファイルのプリミティブはランタイムが提供し、行に Fs を載せる。純粋な文脈からは呼べない。
//   __open  : (String) => Int32 @ Fs
//   __read  : (Int32) => String @ Fs
//   __write : (Int32, String) => Unit @ Fs
//   __close : (Int32) => Unit @ Fs
// サブエフェクティングが無いので、ハンドラの外側の行は body の行から File を除いたものと一致する。
// with_file 自身が __open と __close で Fs を起こすため外側の行には Fs が載る。したがって body の行にも Fs を書く。
let with_file[A, E](path: String, body: () => A @ {File, Fs extends E}): A @ {Fs extends E} = {
  let h = __open(path)
  body() handle {
    case read()    => resume(__read(h))
    case write(s)  => resume(__write(h, s))
    case return(x) => { __close(h); x }
    case cancel    => __close(h)
  }
}

// --- with ---
//
// `with x = f(a)` は `f(a, fn(x) => 残りの文)` への純粋な構文糖。
// 束縛側が `_` のときは `f(a, fn() => 残りの文)` と、引数なしの継続に脱糖する。
// 「呼び出しの末尾に継続を足す」という一つの規則で、defer相当も逐次合成も兼ねる。
// ppx_let の `let%name` のような別構文は用意しない。
let copy(src: String, dst: String): Unit @ {Console, Fs} = {
  with _ = with_file(src)
  let text = perform read()                   // File は src のものが最左
  with _ = with_file(dst)
  perform write(text)                         // File は dst のものが最左
}

// 逐次合成が欲しいライブラリ（パーサコンビネータ等）も同じ規則に乗る。
module Parser {
  pub newtype Parser[A] = Parser((String) => Option[{value: A, rest: String}] @ {})
  pub let bind[A, B, E](p: Parser[A], f: (A) => Parser[B] @ E): Parser[B] @ E = ???
  pub let pure[A](x: A): Parser[A] = ???
  pub let token(t: String): Parser[String] = ???
}

let parens(): Parser.Parser[(String, String)] = {
  with x = Parser.bind(Parser.token("("))
  with y = Parser.bind(Parser.token(")"))
  Parser.pure((x, y))
}

// --- エフェクト行に名前を付ける ---
//
// リクエストスコープの値は Go の context.WithValue ではなくハンドラで表現する。
// ハンドラは動的スコープそのものであり、型付きで、キー衝突がなく、行に現れるので
// 署名から見える。引き回さないので中間の関数は何も書かなくてよい。
effect ReqId  = { req_id: () => String }
effect Logger = { log: (String) => Unit }
effect Tracer = { span: (String) => Unit }

// 実用規模では行が肥大化するので、カインド EffectRow のエイリアスでまとめる。
// 行の中に書くと展開される。
type Request: EffectRow = {ReqId, Logger, Tracer}

pub let handle_request(r: Req): Resp @ {Request, Db, Async} = {
  perform log("handling " + perform req_id())
  Db.query(r.query)
}

// トップレベルに残せるエフェクトはランタイムが提供するもの（Console、Async、Fs、Blocking）だけ
perform write(capture(fn() => println("test")).output)

// ============================================================
// 10. リージョン（run）
// ============================================================

// `run h { … }` は rigid なリージョン変数 h を導入し、Heap[h] エフェクトを消す。
// h が結果型に漏れていないことを脱出検査で確かめる（Koka の st<h> と同じ）。
// ランク2多相を一般機能として持たないので、構文として提供する。
// run はハンドラなので、キャンセルされればリージョンも巻き戻される。
//
// Heap[h] は操作を持たないエフェクトラベルで、Ref と可変配列の操作だけがこれを行に載せる。
// 配列は不変の Array[A] と可変の MutableArray[h, A] に分ける。
// 可変配列はリージョン変数を型に持つので脱出検査が効き、不変配列はリージョンから出てよい。
// 引数を破壊的に更新する関数は、もう純粋としては型付かない。
// これで §11 の並列性の決定性と、§13 の「`@` を省略した pub は純粋」という約束を型が守る。
// 標準ライブラリ側のシグネチャ（`[h, A]` は型パラメータ。ここだけの表記で、型式の構文ではない）：
//   Ref.new             : [h, A] (A) => Ref[h, A] @ Heap[h]
//   Ref.get             : [h, A] (Ref[h, A]) => A @ Heap[h]
//   Ref.set             : [h, A] (Ref[h, A], A) => Unit @ Heap[h]
//   Array.length        : [A] (Array[A]) => Int32
//   Array.get           : [A] (Array[A], Int32) => A
//   Array.each          : [A, E] (Array[A], (A) => Unit @ E) => Unit @ E
//   MutableArray.new    : [h, A] (Int32, A) => MutableArray[h, A] @ Heap[h]
//   MutableArray.length : [h, A] (MutableArray[h, A]) => Int32 @ Heap[h]
//   MutableArray.get    : [h, A] (MutableArray[h, A], Int32) => A @ Heap[h]
//   MutableArray.set    : [h, A] (MutableArray[h, A], Int32, A) => Unit @ Heap[h]
//   MutableArray.freeze : [h, A] (MutableArray[h, A]) => Array[A] @ Heap[h]
// 添字が範囲外なら実行時エラー。
// freeze は可変配列の内容を不変配列として取り出す。freeze 後に元の可変配列へ書いても
// 取り出した配列は変わらない（観測可能な契約。コピーするかどうかは実装戦略）。
let sum(xs: Array[Int32]): Int32 = run h {
  let acc = Ref.new(0)                        // Ref[h, Int32] @ Heap[h]
  Array.each(xs, fn(x) => Ref.set(acc, Ref.get(acc) + x))
  Ref.get(acc)
}
// sum の型に行は現れない。`@` を省略した let なので、純粋な本体が行変数として一般化される（§9）。
// 外から見て純粋、中は命令型。だから行変数を `{}` に具体化して下の par_map に渡せる。
// run が消すのは Heap[h] だけなので、他のエフェクトは通り抜ける。

// 中で組み立てて外に出すときは freeze する
let doubled(xs: Array[Int32]): Array[Int32] = run h {
  let out = MutableArray.new(Array.length(xs), 0)
  let i = Ref.new(0)
  Array.each(xs, fn(x) => {
    MutableArray.set(out, Ref.get(i), x * 2)
    Ref.set(i, Ref.get(i) + 1)
  })
  MutableArray.freeze(out)
}
// 不変配列に set は無い。可変配列は h を型に持つので、リージョンの外で作った値を引数として受け取れない。
// 引数の h は run が導入した h とは別物なので、`run h { MutableArray.set(a, 0, 42) }` の Heap[h] は消えない。

// ============================================================
// 11. 並行性・並列性
// ============================================================

// 並列性は純粋な計算に限るので決定的である。
let par_map[A, B](xs: Array[A], f: (A) => B @ {}): Array[B] = ???
let par[A, B](fa: () => A @ {}, fb: () => B @ {}): (A, B) = ???

// 並行性はランタイム提供のエフェクト。ユーザはハンドルできない（スケジューラは書かせない）。
//
// yield_ はキャンセルの配送点である。キャンセルは協調的であり、
// 中断点でのみ配送される。純粋な長いループは中断できないので、
// Go で ctx.Done() を select するのと同じ規律で yield_ を挟む。
effect Async = { yield_: () => Unit, sleep: (Int64) => Unit }

// スコープは値ではなくエフェクトにする。
// Scope 値を引き回さなくてよく、Scope のための脱出検査も要らない
// （行が代わりに保証する）。脱出検査は run のためだけに残る。
effect Nursery = { spawn: (() => Unit @ Async) => Unit }

// 正常脱出＝全員をjoin / 異常脱出＝全員をキャンセルしてからjoin。
// キャンセルは §9 の自動巻き戻しがそのまま実装になる（追加機構なし）。
// 子タスクは親より長生きできない（構造化並行性）。
let scope[A, E](body: () => A @ {Nursery, Async extends E}): A @ {Async extends E} = ???

let serve(cs: List[Conn]): Unit @ Async =
  scope(fn() => each(cs, fn(c) => perform spawn(fn() => handle_client(c))))

// Go の context.Context に相当する型は導入しない。context が束ねている四つの仕事は
// それぞれ既存の機構に落ちる：
//   キャンセルの伝播      → scope の入れ子＋自動巻き戻し
//   デッドライン          → 下の Deadline エフェクトと with_timeout
//   リクエストスコープ値  → ハンドラ（§9 の Request）
//   呼び出し木の構造化    → scope の入れ子
//
// 期限は入れ子にすれば外側が内側を強制的に巻き戻すので、min の継承が構造から出る。
// 残り時間を読みたい場合（ソケットのタイムアウト設定、諦めの判断）だけ操作が要る。
effect Deadline = { deadline: () => Option[Instant] }

let with_timeout[A, E](
  ms: Int64,
  body: () => A @ {Deadline extends E},
): Option[A] @ {Async extends E} = ???

// リクエストより長生きしてよいタスク（監査ログ、キャッシュ温め、メトリクスの掃き出し）は
// 外側の nursery を名前で指す。context.Background() と違って署名に現れるので、
// 「このハンドラはリクエストより長生きするタスクを作る」ことが型から分かる。
effect Background = { spawn_bg: (() => Unit @ Async) => Unit }

pub let handle_audited(r: Req): Resp @ {Request, Db, Background, Async} = {
  let resp = handle_request(r)
  perform spawn_bg(fn() => audit_log(r, resp))
  resp
}

// 長い計算の途中でキャンセルされうるようにする例
let crunch(xs: Array[Int32]): Int32 @ Async = run h {
  let acc = Ref.new(0)
  Array.each(xs, fn(x) => {
    perform yield_()                          // キャンセル配送点
    Ref.set(acc, Ref.get(acc) + heavy(x))
  })
  Ref.get(acc)
}

// run のヒープハンドルはタスク境界を越えられないので共有可変状態が存在しない。
// メモリモデルを仕様に書く必要がなく、アトミックもロックも要らない。通信はチャネルで行う。
let channel[A](capacity: Int32): Chan[A] = ???
let send[A](c: Chan[A], x: A): Unit @ Async = ???
let recv[A](c: Chan[A]): A @ Async = ???

// ============================================================
// 12. FFI
// ============================================================

extern "C" let sin(x: Float64): Float64                  // ブロックしない
extern "C" let sqlite_step(s: Stmt): Int32 @ Blocking    // ブロックしうる

// ブロックするかどうかを知っているのはバインディングの作者なので、印は宣言側に付ける。
// 行多相により、呼び出し元の署名へ自動的に伝播する。
//
// 仕様に書くのは観測可能な契約だけとし、実装戦略は書かない：
//   「Blocking領域の実行は、他のタスクに利用可能な並列度を
//     （実装定義の上限まで）減少させない」
//
// Blocking はランタイムが実装を持つ操作なしのエフェクトラベルで、Heap と同じく宣言は要らない。
// トップレベルに残してよく、下の pinned で落とすこともできる。
// Blocking 領域はキャンセル配送点ではない（native コードは中断できない）。
// pinned はタスクを専用スレッドに縛る。スレッド親和性のあるライブラリには必須。
let pinned[A, E](body: () => A @ {Blocking extends E}): A @ E = ???

// ============================================================
// 13. モジュールと可視性
// ============================================================

// pub を付けたものだけがパッケージ外に公開される。
// pub を付けるには型注釈が完全でなければならない。入れ子の矢印の `@` も省略できない。
// 省略の意味（`@ {}`）は決まっているが、公開 API では純粋を意図したのか書き忘れたのかを読み手が区別できる必要があるため。
// 最外の矢印のエフェクト行を省略した場合は推論に任せず、「本体は純粋でなければならず、
// 公開される型は行多相」と読む（§9）。呼び出し側はどの行の下からでも呼べる。
// 実装を変えた拍子に公開APIのエフェクト行が変わって下流が壊れるのを防ぐため。
// newtype の型名とコンストラクタは可視性を共有する。pub なら両方公開し、pub でなければ両方隠す。
// 型名だけ公開して表現を隠す手段はまだ無い（§14）。
module BigInt {
  pub newtype BigInt = ???                    // `???` は未実装のホール
  pub let parse(str: String): BigInt = ???    // 省略 = 本体は純粋、公開される型は行多相
  let normalize(x: BigInt): BigInt = ???      // pubなし。注釈は自由に書ける

  // インスタンスは常に大域可視。pub は書かない
  type instance Add[BigInt] { let add(x, y) = ??? }
  type instance Mul[BigInt] { let mul(x, y) = ??? }
}

type MyBigInt = BigInt  // コンパニオン型（モジュール名と同名の型はモジュール名自体で参照できる）

let big_sum(): MyBigInt = BigInt.parse("123") + BigInt.parse("456")

