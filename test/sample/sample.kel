#!/usr/bin/env keleut
// shebang 行は省略できる
// 行コメント
/* ブロックコメント /* 入れ子にできる */ */
// * コメントの書式には Markdown を推奨する *

// ============================================================
// 0. 括弧の役割
// ============================================================
// ()    グループ化、引数リスト、パラメータリスト、タプル
// {}    レコード、ブロック、match の本体、handle の本体、エフェクト行、エフェクト宣言の本体
// #Foo  構造的ヴァリアントのコンストラクタ
// []    型パラメータリスト
//
// `#` は構造的ヴァリアントにだけ付ける。
// 名目的なコンストラクタと同じ構文上の位置に現れるのは、ヴァリアントのラベルだけである。
// そのため、区別の印が必要なのもヴァリアントのラベルだけである。
// 印がないと、`Foo(x)` の意味が「スコープに名目的なコンストラクタ Foo があるかどうか」で変わってしまう。
//
// --- `{` の読み分け（2 トークン先読み） ---
//   `}`                                   → 空（Unit 値、空レコード、空タプル）
//   IDENT `=` / `,` / `with` / `extends`  → レコード
//   `extends`                             → レコード（行変数だけを持つ）
//   IDENT `:`                             → レコード型
//   それ以外                               → ブロック
//   `@` の直後、EffectRow のエイリアスの右辺、effect 宣言の本体では、上の表のどれに分類されても、
//   エフェクト行または宣言本体として読む。
//   （構文解析では 3 種を同じ構文木で表し、意味解析の段階で区別してよい。この位置で先読みをやめる実装でも結果は同じになる）
//   `{x}` は IDENT `}` なのでブロックになる。フィールドが 1 個のレコードは、`{x = x}` か、略記（パンニング）の `{x,}` で書く。
//
// この規則は、代入演算子がないことを前提にしている。
// 将来 `r.f = v` を加えるとレコードとブロックを区別できなくなるので、代入演算子は加えない。
//
// --- `(` の読み分け（1 トークン先読み） ---
//   型位置で `)` の直後が `=>`         → 関数型。それ以外はタプル型
//   式位置で括弧の直下に `,` がある   → タプル。なければグループ化
//   呼び出し先の直後、`fn` の直後      → 引数リスト、パラメータリスト
//
// --- 字句 ---
// ソースは UTF-8 で書く。BOM（U+FEFF）はソースのどこにあっても字句エラーにする。先頭だけの規則ではない。
// BOM は幅を持たないので、識別子の途中に紛れ込むと、読み手に見えないまま別の名前になる。これを防ぐための規則である。
// 例外は文字列リテラルの中（文字として値に残る）とコメントの中（読み飛ばす）である。
// 改行は LF とする。文字列リテラルの外では CR を空白として扱うので、CRLF も改行として働く。
// 文字列リテラルの中の CR は、そのまま値に残る。
// カンマ区切りのリストでは、どの種類でも最後の要素の後ろに末尾カンマを置ける。対象は引数、パラメータ、型引数、
// 型パラメータ、レコード、タプル、パターン、エフェクト行、effect 宣言の操作、コンストラクタのフィールド、`F[_, _]` の穴である。
// `...rest` と `extends R` は要素ではなく終端子なので、その後ろには置けない。
// ただし `(e,)` は末尾カンマではなく 1 要素タプル（§4）と読む。タプルで末尾カンマとして働くのは 2 要素以上の場合である。
// 識別子は小文字で始める。大文字で始まる名前は、型名、コンストラクタ、エフェクト名、モジュール名に使う。
// 型パラメータはこの規則の対象外で、文法上は大文字で始めても小文字で始めてもよい。慣習として、型は大文字
// （`[A]`、`[E]`、`[F[_]]`）、リージョン変数は小文字（`[h, A]`）で書く。§10 の署名一覧がこの書き分けの例である。
// ただし `run` が導入するリージョン変数は、文法上も小文字で始まる識別子に限る（`run h { … }`。`run H` は構文エラー）。

// ============================================================
// 1. 型エイリアス
// ============================================================

type MyInt = Int32
type Unit  = {}                      // 空レコード。`()` も同じものを指す

type Point = {x: Float64, y: Float64}
type Pair  = (Int32, String)

// 構造的ヴァリアント。`#` 付きのコンストラクタは大域的なラベルであり、
// どの型にも属さない（OCaml の多相ヴァリアントと同じ位置付け）
type Parity = #Even | #Odd

// エイリアスにはカインドを注釈できる。省略すると Type になる。
// カインド EffectRow のエイリアスを使うと、エフェクト行に名前を付けられる（§9 の Request を参照）。
// 新しい構文を加えずに、長くなった行をまとめられる。
// カインド EffectRow の名前を書けるのは、行の位置だけである。具体的には、`@` の直後、行の中、
// カインド EffectRow のエイリアスの右辺、カインド EffectRow のパラメータへ渡す型引数である。
// 値の型の位置（矢印の引数と返り値、レコードのフィールド、タプルの要素、ヴァリアントの積載値、注釈）に書くと、
// その位置でエラーになる。
//
// 型エイリアスは再帰できない。
// 透過的なエイリアスの再帰を許すと、言語が等再帰型を採用することになる。
// そうすると、ラベルの打ち間違いがエラーにならず、無限の型として現れてしまう。
// 再帰データは newtype を通して定義する。

// ============================================================
// 2. リテラル
// ============================================================

// 整数リテラルには、「整数型でなければならない」という述語を持つ単一化変数を割り当てる。
// この述語は型クラスではない。組み込みの数値型だけがこの述語を満たし、利用者はインスタンスを追加できない。
//   - 単一化は通常どおり進む
//   - 一般化の時点で未解決なら既定の型にする（Integral → Int32、Fractional → Float64）
//   - この変数は一般化しない（束縛の時点で必ず具体的な型に決める）
// これにより、型クラス一般に働く既定化の規則（Haskell の defaulting）も、単相性制限も要らなくなる。
let a = 0                            // Int32（未解決なので既定の型になる）
let b: Int64 = 0                     // Int64（注釈との単一化で決まる）
let c = 0i64                         // 接尾辞。曖昧さをなくす明示的な手段として残す
let d = -1                           // 符号はリテラルの字句に含まれる（単項マイナスではない）
let e = 1.5                          // Float64
// let f = 0 + "x"                   // エラー: String は整数型ではない

// Integral と Fractional は、型クラス制約と同じ制約集合に入る（上で述べたとおり、利用者はインスタンスを書けない）。
// 曖昧性検査（型からたどれない制約付きの型変数を拒否する検査）は、この 2 つの述語だけを対象外にする。
// 既定化で必ず型が決まるためである。
// `Zero` や `One` のようなクラスは設けない（リテラルの述語で足りる）。
//
// 浮動小数リテラルは `1.5`、`1e5`、`1.5e-3` の形で書く。指数部は、`e` または `E` の後に符号付きの 10 進数を続ける。
// 小数部は省略できる（`1.` は 1.0、`1.e5` は 1e5）。先頭の小数点（`.5`）は認めない。`t._0` のような射影と読み分けるためである。
// 最長一致により、`1._0` や `1.foo` は「数値の後に識別子」と読む。数値リテラルへの射影は書けないが、
// 数値は行を持たないので、書けなくても困ることはない。
// 非有限値（NaN、無限大）のリテラルはない。
// Float64 の文字列化では、読み戻すと同じ値になることを守ったうえで、次の規則で表記を決める。
// 絶対値が 1e16 未満の整数値は小数点表記にする（`1e5` ではなく `100000.0`）。それ以外は有効数字を 1 桁ずつ増やし、
// 最初に読み戻せた表記を使う。このとき指数部の `+` と先頭の `0` は除く（`1e16`、`1e-5`）。どちらの場合も、
// 小数点も指数もない表記には `.0` を加える（`1` は整数リテラルなので別の値になるため）。
// 「最短」は有効数字の桁数についての規則であり、固定小数点表記と指数表記のどちらを選ぶかには関わらない
// （`0.0001` を `1e-4` にはしない）。
// 非有限値だけは例外で、`nan`、`inf`、`-inf` と書く（符号付きの NaN も `nan` と書く）。
//
// 数値型の間の暗黙変換はない。明示的に変換するプリミティブは `__<元>_to_<先>` の形で、型名は `i32`、`i64`、`f64` と綴る
// （`__i32_to_i64`、`__i32_to_f64`、`__i64_to_i32`、`__i64_to_f64`、`__f64_to_i32`、`__f64_to_i64`。
// 算術の `__int32_add` とは綴りが異なる）。
// 浮動小数から整数への変換では、NaN と範囲外の値を実行時エラーにし、範囲内の値はゼロ方向に切り捨てる。
// Int64 から Int32 への変換は折り返す（wrap-around）。整数算術の桁あふれも折り返す（暫定。§14）。
// ゼロ除算は実行時エラーにする。
//
// 文字列リテラルは `"…"` と書く。文字列は UTF-8 のバイト列であり、Char 型はない。
// エスケープは `\n` `\t` `\r` `\a` `\b` `\f` `\v` `\\` `\"` `\'` と、コードポイントを指定する
// `\uXXXX`（4 桁）と `\UXXXXXXXX`（8 桁）である。サロゲートと範囲外のコードポイントは字句エラーにする。
// 文字列には生の改行を含めてよい。

// ============================================================
// 3. レコードと行多相（Scoped Labels）
// ============================================================

// 行変数は `extends` の右に書く。`{extends R}` は「行 R を持つレコード」を表す
let sum_xy[R](p: {x: Float64, y: Float64 extends R}): Float64 =
  p.x + p.y                                   // 選択 `r.l`

let with_z[R](p: {extends R}): {z: Float64 extends R} =
  {z = 0.0 extends p}                         // 拡張 `{l = e extends r}`

let move_x[R](p: {x: Float64 extends R}, dx: Float64): {x: Float64 extends R} =
  {p with x = p.x + dx}                       // 更新 `{r with l = e}`
// 更新の基底 r は、小文字で始まる識別子 1 個に限る（§0 の `{` の読み分けが、IDENT の直後の `with` しか見ないため）。
// `{p.origin with …}` や `{f(x) with …}` は書けない。基底に式を使いたいときは、先に let で束縛する。
// 大文字で始まる識別子はコンストラクタであってレコードではないので、`{P with …}` も書けない（構文エラー）。

// scoped labels では、同じラベルのフィールドを加えても既存のフィールドを上書きせず、その外側に重ねる
// 制限は `r \ l` と書く（`-` は減算と衝突するので使わない）
let outer_x(): Float64 = {
  let p = {x = 1.0 extends {x = 2.0, y = 3.0}}
  // p の型は {x: Float64, x: Float64, y: Float64}
  p.x                                         // => 1.0（外側）。`(p \ x).x` は 2.0（内側）
}

// パンニング。`{a, b}` は `{a = a, b = b}` の略記である
let make_point(x: Float64, y: Float64): Point = {x, y}

// ============================================================
// 4. タプル（重複ラベルの糖衣構文）
// ============================================================

// タプルは「同じラベル `_item` を重ねたレコード」の糖衣構文である。
// scoped labels は、同じラベルどうしの順序だけを保存する。
// この性質は、タプルの「位置に意味がある」という要求にそのまま合う。
//
//   (A, B, C)  ≡  {_item: A, _item: B, _item: C}
//   (a, b, c)  ≡  {_item = a extends {_item = b extends {_item = c}}}
//   (a,)       ≡  {_item = a}                    1 要素タプル
//   ()         ≡  {}                             空タプル = 空レコード = Unit
//
// cons と tail は、レコード演算でそのまま書ける（マクロは要らない）。
//   cons  {_item = v extends t}
//   head  t._item
//   tail  t \ _item
//
// 位置によるアクセスは `t._0`、`t._1` … と書く。`t.0` にしないのは、`t.0.1` が
// 浮動小数点リテラルと字句上で衝突するためである（Rust が実際に苦労した点）。
//   t._0 ≡ t._item
//   t._1 ≡ (t \ _item)._item
//
// ラベル名は `_item` とする。処理系は、`_item` だけからなる閉じた行をタプルの表記に戻して表示する。
// 対象は、型の表示、型エラーの文面、実行時エラーに出る値、網羅性警告の反例の 4 つすべてである。
// 型は、2 要素以上を `(A, B)`、1 要素を `(A,)`、空行を `{}` と表示する。
// 値とパターンは、2 要素以上を `(a, b)`、1 要素を `(a,)`、空行を `()` と表示する。
// 型と値で表記が異なるのは空行だけである。空行は、型でも値でもパターンでも、`{}` と `()` のどちらで書いても同じものを指す。
// そこで、型は Unit の表記 `{}`（§1）に、値とパターンは 0 要素タプルの表記 `()` にそろえた。
// どちらの場合も、表示された表記をそのままソースに貼り戻せる。
// 1 要素の末尾カンマを落とさないのも、貼り戻せる表記にするためである。`(a)` は式でもパターンでもグループ化になる。
// 開いた行（`{_item: A extends R}`）はタプルではないので、タプル表記に戻さず、`_item` をそのまま表示する。
let swap[A, B](p: (A, B)): (B, A) = (p._1, p._0)

// 閉じた行なので、要素数（arity）は静的に検査する。
// `(A, B)` は行変数を持たないので、3 要素タプルとは単一化しない。

// 行変数を明示すれば、「先頭が A であるような任意のタプル」を受け取れる。
// 名目的なタプルでは書けない、先頭部分についての多相性が得られる。
let fst[A, R](t: {_item: A extends R}): A = t._item

// ただし、要素数について再帰する関数は書けない。
// 基底ケース（`{}`）と「行が空かどうか」の分岐が必要だが、構造的な型へのインスタンスを
// 利用者に書かせない方針の下では、これを表現できない。cons と tail は書けるが、それを使って繰り返すことはできない。
//
// また、`_item` は普通のラベルなので、抽象化は完全ではない。
// `{x = 1, _item = "hi"}` も fst に渡せる。これは意図して許している
// （`_item` を字句の段階で禁止すると cons が書けなくなり、この設計の利点が失われるため）。

// ============================================================
// 5. 構造的ヴァリアント
// ============================================================

// ヴァリアントも行多相である。`| R` は「他のケースもありうる」ことを表す
let describe[R](v: #Even | #Odd | R): String =
  v match {
    case #Even => "even"
    case #Odd  => "odd"
    case _     => "unknown"                   // 残りの行 R をまとめて受け取る
  }

// 積載値は常に 1 個である。ラベルごとに引数の個数を持たせると、行の単一化規則が複雑になるためである。
// `#Foo(a, b)` は `#Foo((a, b))` の糖衣構文で、式でもパターンでも同じように使える。
type IoError    = #NotFound(String) | #Denied(String)
type ParseError = #Syntax((Int32, Int32))

let report(e: IoError | ParseError): String =
  e match {
    case #NotFound(path)    => "not found: " + path
    case #Denied(path)      => "denied: " + path
    case #Syntax(line, col) => "syntax error"  // #Syntax((line, col)) と同じ
  }

// 構造的ヴァリアントは、開いた和型を組み合わせる用途に使う。
// 再帰させたい場合と、型クラスを実装したい場合は newtype を使う。

// ============================================================
// 6. 名目的な型（newtype）
// ============================================================

// newtype の右辺は型式ではなく、コンストラクタ宣言の並びである。
// コンストラクタは複数の値を取れるので、値を二重に包まずに済む。右辺全体を穴 `???` にもできる（§13 の BigInt）。
newtype Option[A] = Some(A) | None
newtype List[A]   = Cons(head: A, tail: List[A]) | Nil
newtype Never                                 // コンストラクタを持たない型

// コンストラクタのフィールドは常に順序を持つ。ラベルは付けても付けなくてもよい。
//   Some(A)                       … 無名。位置指定でだけ束縛できる
//   Cons(head: A, tail: List[A])  … ラベル付き。位置指定でも `Cons(tail = t)` の形でも書ける
// 両者を混在させてもよい。
// 型パラメータのカインドは、宣言群の中の型の本体での使われ方から推論する。使われ方がなければ Type とする。
// §9 の Callback[E] の E は矢印の `@` に現れるので、EffectRow に決まる。
// 推論に使うのは型の本体だけで、値の本体（let の右辺）は数えない。自分の宣言で使われていなくても、
// 同じ宣言群の別の宣言が行として使えば、そのパラメータは行になる。
// 1 つのパラメータが持てるカインドは 1 つである。同じパラメータを行の位置と値の位置の両方で使う宣言は、
// その宣言の時点でエラーになる。
// 型引数の読み方は、対応するパラメータのカインドによって変わる。カインドが EffectRow なら引数をエフェクト行として読み、
// `{}` は空行、`Print` は `{Print}` の略記、`{Print extends E}` は開いた行になる（§9 の `@` の右側と同じ読み方）。
// カインドが Type なら引数を型として読み、`{}` は空レコード（= Unit、§1）になる。
// 同じ `{}` が、`Callback[{}]` では純粋な行を、`Box[{}]` では Unit を指す。

// コンストラクタが 1 個で、その名前が型名と同じ場合の略記
newtype UserId(Int32)                         // = newtype UserId = UserId(Int32)
newtype TotalFloat64(Float64)                 // §14 の Ord[Float64] の案 (1) を想定した名前。Ord を実装するかは未定

let some_one(): Option[Int32] = Some(1)

let get_or[A](v: Option[A], default: A): A =
  v match {
    case Some(x) => x
    case None    => default
  }

// ============================================================
// 7. 関数・束縛・ブロック
// ============================================================

// 関数は複数の引数を取り、1 個の値を返す。引数の個数（arity）は矢印型の一部である。
//   (Int32, Int32) => Int32  と  (Int32) => (Int32) => Int32  は別の型
// カリー化と部分適用は、言語機能としては提供しない。
//
// 評価順序は左から右である。引数リスト、レコードの各フィールド、match の照合対象は、どれも左から右へ評価する。
// `{l = e extends r}` は e を先に、r を最後に評価する。
// タプルの脱糖はこの規則に従うので、(a, b, c) は a、b、c の順に評価する。
//
// 末尾に式がないブロックの型は Unit である。そのため、Unit の値を明示的に書く場面はほとんどない。

// let は文であり、`in` はない。ブロックの最後の式がブロックの値になる。
let list_length[A](xs: List[A]): Int32 = {
  // let で束縛する関数は、型注釈を省略できる
  let rec aux(xs, n) = xs match {             // match は Scala と同じく後置する
    // 網羅性を検査する
    case Nil           => n
    case Cons(_, tail) => aux(tail, n + 1)    // 位置指定のパターン
  }
  aux(xs, 0)
}
; // トップレベルの宣言を区切るセミコロンはいつでも省略できるが、
  // REPL やエディタの補完を制御するために、書くこともできる
  // ただし、行頭の `(` は前の行の続きとはみなさない（改行による区切りが優先する）

let twice_sum_xy(p: Point): Float64 = {
  let doubled = {                             // ブロックは式である
    let s = p.x + p.y
    s + s
  }
  doubled - p.x
}

// let はパターンで分解できる
let dist(p: Point): Float64 = {
  let {x, y} = p
  sqrt(x * x + y * y)
}

// タプルパターンでは、`...rest` で残りの部分を束縛できる（行の制限がパターンに現れたもの）
let head_and_rest[A, R](t: {_item: A extends R}): A = {
  let (x, ...rest) = t
  x
}

// 無名関数は `fn(x) => e` と書く。
// `(x) => e` にしないのは、式位置の `(` がタプルと衝突するためである。
// `fn` を前に置くことで、パラメータリストとタプルを構文上で区別できる。
let inc_all(xs: List[Int32]): List[Int32] = map(xs, fn(n) => n + 1)

// ガード付きパターン `case P if cond => e`
// 網羅性検査は、ガード付きのケースを「必ず一致する」ケースとして数えない。
// そのため、最後にガードのないケースが必要になる
let rec count_if[A, E](xs: List[A], pred: (A) => Boolean @ E): Int32 @ E =
  xs match {
    case Nil                            => 0
    case Cons(head, tail) if pred(head) => 1 + count_if(tail, pred)
    case Cons(_, tail)                  => count_if(tail, pred)
  }

let rec is_even(n: Int32): Boolean =
  n match {
    case 0          => true
    case n if n < 0 => is_even(0 - n)
    case n          => is_odd(n - 1)
  }
and is_odd(n: Int32): Boolean =
  n match {
    case 0          => false
    case n if n < 0 => is_odd(0 - n)
    case n          => is_even(n - 1)
  }

// or パターン（`case #Even | #Odd =>`）は導入しない。パターンの文法に `|` を入れないでおけば、
// 必要になってから追加しても、既存の文法と衝突しないためである。
//
// 節の最上位に現れる `=>` は、常に節の矢印である。将来 `case p: T => e` のようにパターンへの型注釈を
// 導入する場合は、矢印を含む型注釈に括弧を必須にする（字句解析の段階では、型がどこで終わるかを決められないため）。

// ============================================================
// 8. 型クラス
// ============================================================

// パラメータが 1 個の型クラスと、高カインド型（HKT）に対応する。
// ランク 2 多相と多パラメータ型クラスは、意図して除外する。代わりにエフェクトと行多相を使う。
// コヒーレンス（インスタンスの一意性）は守る。インスタンスは常に大域的に見え、隠したり選び直したりできない。
// 型クラスのパラメータのカインドは、Type か、HKT の `F[_]` のように Type を取って Type を返す形に限る
// （穴は `F[_, _]` のように複数でもよい）。
// EffectRow のパラメータは取れない。インスタンスは型構成子のタグで選ぶので、行は選択の鍵にならないためである。
// エフェクトについて量化したいときは、クラスのパラメータではなく、メソッドの型パラメータとして行変数を取る
// （下の Functor の map が例）。
//
// 利用者定義の演算子は導入しない。組み込みの演算子が、標準ライブラリの型クラスのメソッドを呼ぶ。
//   +  Add.add      -  Sub.sub      *  Mul.mul      /  Div.div
//   == Eq.eq        != Eq.eq の否定
//   <  Ord.lt       <= Ord.le       >  Ord.gt       >= Ord.ge
//   && || !         Boolean の組み込み（短絡評価するので、型クラスにはできない）
//   \               行の制限（組み込み構文）
//
// Num のような 1 つのクラスにまとめないのは、String のように `+` だけを持つ型があるためである。
type class Add[A] { val add: (A, A) => A }
type class Mul[A] { val mul: (A, A) => A }

type instance Add[Int32]  { let add(x, y) = __int32_add(x, y) }
type instance Mul[Int32]  { let mul(x, y) = __int32_mul(x, y) }
type instance Add[String] { let add(x, y) = __string_concat(x, y) }

let fma[A: Add + Mul](x: A, y: A, z: A): A = x * y + z   // add(mul(x, y), z) に変換される

// --- 構造的な型へのインスタンス ---
//
// 利用者には書かせない。コヒーレンスを守るため、組み込みの自動導出だけがインスタンスを与える。
// 導出規則は、クラス宣言に 1 つだけ付ける。誰でも任意のクラスに導出を書けるようにすると、
// 2 つのパッケージが、同じ構造型に別々の Eq を導出するおそれがある。
type class Eq[A] {
  val eq: (A, A) => Boolean
  derive structural                           // 組み込みの構造的導出を有効にする
}

// 導出は閉じた行にだけ適用する。行変数を含む型は比較できない。
// （フィールドごとの行制約 `[R: Eq]` を導入すれば比較できるが、カインドと制約解決に手を入れる必要があるので採用しない）
let same_point(p: Point, q: Point): Boolean = p == q
let same_pair(p: Pair, q: Pair): Boolean = p == q         // タプルも閉じた行なので比較できる
// let same[R](p: {x: Int32 extends R}, q: {x: Int32 extends R}) = p == q   // エラー
//
// `derive structural` を書けるのは、クラスパラメータのカインドが Type のクラスだけである。
// 構造的導出は、行の各フィールドの型へ再帰する規則なので、Functor のように型引数を取るクラスには適用できない。
// カインドで判別できるので、宣言の時点でエラーにする。
// 同じカインドの規則により、インスタンスの頭部のカインドは、クラスパラメータのカインドと一致しなければならない。
// §9 の Callback[E] の頭部は、EffectRow を取って Type を返すカインドである。これは Functor[F[_]] が要求する
// 「Type を取って Type を返す」カインドと合わないので、Callback は Functor のインスタンスになれない。これも宣言の時点でエラーにする。

// --- スーパークラスと前提付きインスタンス ---
//
// スーパークラス（クラスパラメータへの制約 `type class Ord[A: Eq]`）は導入しない。
// 制約の含意がないほうが、署名に書いた制約だけで解決が決まり、規則が単純になるためである。
// Ord は Eq を含意しないので、両方が必要な場面では `[A: Eq + Ord]` と並べて書く。
//
// 前提付きインスタンスでは、型パラメータリストを `instance` の直後に書く。`instance` と `[` の間の空白や改行は自由である。
// インスタンスの型に書く `_` の個数は、その型構成子が取る型引数の個数と一致しなければならない。
// リストの型パラメータは、インスタンスの型に現れる `_` へ左から順に対応する
// （下の `Eq[List[_]]` の `_` は `[A: Eq]` の A に対応する）。
// 型パラメータの個数は、`_` の個数を超えてはならない。対応しなかった右側の `_` は未適用のまま残り、
// 頭部は型引数を取るカインドのままになる（`Eq[List[_]]` は 1 個を対応させるので Type、
// `Functor[List[_]]` は 1 個も対応させないので、型引数を 1 個取るカインドになる）。
// 型パラメータのカインドは、対応する `_` の位置で型構成子が要求するカインドと一致しなければならない。
// 型パラメータの名前はインスタンス本体の型スコープに入るので、メソッドの型注釈で使える。
// メソッド自身の型パラメータと同名なら、内側を優先する。
// 前提はインスタンスの選択にだけ使う。コヒーレンスにより選択は静的に一意に決まるので、前提を値として渡す手段はない。
type instance[A: Eq] Eq[List[_]] {
  let rec eq(xs, ys) = (xs, ys) match {
    case (Nil, Nil)                 => true
    case (Cons(x, xt), Cons(y, yt)) => x == y && eq(xt, yt)
    case _                          => false
  }
}

// --- エフェクト多相 ---
//
// 型クラスのメソッドの矢印にも、エフェクト行を書く。
// 書かないと純粋な関数しか渡せず、高階関数として役に立たない。
// 入れ子の矢印（メソッドの引数の型）で省略した `@` は、`@ {}`（純粋）と読む（§9）。
// エフェクト多相にしたいときは、map のように行変数を型パラメータに取って明示する。
// メソッドの最外の矢印で `@` を省略すると、「どのインスタンスの実装も純粋でなければならず、
// 公開される型は行多相になる」と読む（§9）。
type class Functor[F[_]] {
  val map[A, B, E]: (F[A], (A) => B @ E) => F[B] @ E
}

type instance Functor[List[_]] {
  let rec map[A, B, E](xs: List[A], f: (A) => B @ E): List[B] @ E =
    xs match {
      case Nil              => Nil
      case Cons(head, tail) => Cons(f(head), map(tail, f))
    }
}

// 標準ライブラリは、List と Option に Show のインスタンスを持つ（`type instance[A: Show] Show[List[_]]` と同じ形）。
// 出力は `[1, 2, 3]`、`[]`、`Some(1)`、`None` のようになる。
// Monad、Applicative、Traversable はプレリュードに置かない。理由は次のとおりである。
//  - インスタンスがエフェクトについて中立であることを強いられる（内部で Async を使う型が Monad になれない）
//  - HKT の穴の位置とエフェクトの位置が衝突する
//  - モナドとエフェクトの解釈順が固定される
// エフェクト付きの map が traverse の役割も果たすので、Traversable は要らない。
let user_names[E](xs: List[User]): List[String] @ {Print extends E} =
  map(xs, fn(u) => { println(u.id); u.name })

// ============================================================
// 9. エフェクト
// ============================================================

effect Print   = { print: (String) => Unit }
effect Console = { write: (String) => Unit }   // ランタイムが提供する低レベルのエフェクト
effect Fs      = {}                            // ランタイムが提供するファイル I/O のエフェクトラベル。操作を持たない

// `@` の右側はエフェクト行である。`@ Print` は `@ {Print}` の略記
// 複数なら `@ {Print, Console}`、行変数を含むなら `@ {Print extends E}` と書く
// 空行 `@ {}` は純粋であることを表す
//
// --- 注釈した行の読み方（位置で決まる） ---
//
// 行の部分型付け（サブエフェクティング）はない。関数の行と呼び出し側の行は、単一化で一致させる。
// そのため、注釈をどう読むかによって、書けるプログラムが変わる。
//
// 束縛（let、pub let、extern、型クラスのメソッド）の最外の矢印にラベル付きの行を書くと、
// その行は本体のエフェクトの上限として働く。注釈にないエフェクトを本体が起こすと、エラーになる。
// 一方、公開される型では行変数で行を開くので、呼び出し側の行に他のエフェクトがあってもよい。
// `@ Print` を「ちょうど Print だけ」と読まないのは、このためである。閉じた行と読むと、下の handle の例
// （`println("test") handle …`。本体の println が置かれる行は {Print, Console}）が型検査を通らない。
// `@ {}` だけは両方向に効く。本体は純粋でなければならず、呼び出し側の行も空でなければならない。
// 行変数を含む行（`@ E`、`@ {Print extends E}`）は書いたとおりに多相であり、それ以上は開かない。
//
// 「最外の矢印」は、関数束縛（`let f(x: T): R @ E`）では返り値の後ろの `@` を、
// 値束縛（`let k: (T) => R @ E = …`）では注釈そのものの先頭の矢印の `@` を指す。
// 注釈の先頭が型エイリアスのときは最外の矢印がなく、エイリアスを展開した矢印は入れ子として読む（下記）。
//
// 最外の矢印で `@` を省略したときの意味：
//   let                 本体から推論する。本体が純粋なら行変数として一般化するので、どこからでも呼べる。
//                       本体が `@ {}` の関数（入れ子で `@` を省略したものを含む）を呼んで行が空に決まった場合も、
//                       「純粋な本体」に含める。空行は行の最小元なので、そこから一般化しても型と実際の振る舞いは食い違わない
//   pub let             本体は純粋でなければならず、公開される型は行多相になる（§13）。値束縛の先頭の矢印も同じ
//   型クラスのメソッド   インスタンスの実装は純粋でなければならず、公開される型は行多相になる
//   extern              本体がないので、公開される型が行多相になる
//
// 入れ子の矢印に書いた行は、書いたとおりに読み、行変数で開かない。入れ子の矢印とは、最外以外のすべての矢印である。
// 具体的には、引数の型や返り値の中の矢印、newtype のフィールド、レコード型のフィールド、タプル型の要素、
// effect の操作型の引数に現れる矢印、型エイリアスを展開した矢印が該当する。
// `@` を省略すると、`@ {}`（純粋）と読む。
// エフェクト付きの関数を受け取りたいときは、行変数を型パラメータに取って明示する
// （§8 の map と下の capture が例）。省略した `@` を行変数として一般化すると、newtype のフィールドを経由して、
// エフェクト付きのクロージャを純粋な関数として取り出せてしまう。そのため、省略は純粋と読む。
//
// effect の操作型の先頭の矢印に書いた `@` は、現状では誰も参照しない。操作を perform した文脈の行は handle 側が決めるので、
// ここに書いた行は型付けに影響しない（引数に現れる矢印には、入れ子の規則どおりに書ける）。
// この位置に意味を与えるかどうかは、§14 の TODO で決める。
newtype Callback[E] = Callback(() => Unit @ E)  // エフェクト付きのクロージャを持つ newtype は、このように書く
let println(message: String): Unit @ Print = perform print(message + "\n")

// handle は、エフェクトを別のエフェクトに変換したり、取り除いたりする
// ケースはエフェクト名ではなく操作名で書く（曖昧なら `Print.print` のように修飾できる）
// エフェクトの全操作を網羅する必要がある
//
// 操作名は英小文字で始める。`return` と `cancel` は handle の節の名前と衝突するので、操作名にできない。
// 修飾できるのは操作節だけで、`Print.return` とは書けない。
// 同じ操作名を複数のエフェクトが宣言してよい（上の Console.write と下の File.write）。
// 非修飾の操作名を解決する規則は、perform と handle で異なる：
//   perform  その操作名を宣言しているエフェクトを候補とする。候補が 1 つなら、それに解決する（行に現れているかは問わない）。
//            候補が 2 つ以上なら、その位置のエフェクト行に現れる候補のうち、最も左のものに解決する。
//            行に候補が 1 つも現れなければ、修飾を要求する（推測はしない）。左右は、行に書かれた順序で決まる。
//            行が handle の入れ子から推論で組み立てられている限り、最も左の候補は最も内側のハンドラのエフェクトになる。
//            行を注釈で明示したときは書いた順序をそのまま使うので、実行時の入れ子の順序と食い違うことがある。
//   handle   return 節と cancel 節を除く全節が非修飾のとき、スコープ内のエフェクトのうち
//            「全節の操作名を宣言していて、かつ自分の全操作がこの handle に書かれている」ものを候補とする。
//            候補が 0 個なら網羅漏れ、2 個以上なら修飾を要求する。
//            操作節が 1 つでも修飾されているときは、その修飾先を対象とし、非修飾の節もそのエフェクトの操作として読む。
//            修飾先が 2 つ以上に分かれていれば、エラーにする。
// エフェクト行の並びは、注釈に書いた順序と handle が積んだ順序で決まり、操作名の解決にだけ使う。
// 型の等価性では、異なるラベルの順序を区別しない（§3 の scoped labels と同じ）。
// 下の copy の write は、候補が File と Console の 2 つある。with_file が積んだ File が左にあるので、File.write に解決する。
// 同じエフェクトを二重に積むと、非修飾でも修飾でも、操作は内側のハンドラにしか届かない。
// copy が src を読み終えてから dst を開くのは、そのためである。
//
// ランタイムが実装を持つエフェクト（Console、Async、Fs）は、利用者が handle で処理できない。
// 「ランタイムが実装を持つ」には 2 通りある。1 つは、操作の実装をランタイムが持つ場合（Console の write、Async の yield_ と sleep）である。
// もう 1 つは、操作を持たず、ランタイムのプリミティブだけがそのラベルを行に加える場合
// （Fs と、§9 の `__open`、`__read`、`__write`、`__close` の 4 つ）である。
// perform はできる（ただし Fs は操作を持たないので、perform できる操作がない）。出力先を差し替えたいときは、
// Print のような自前のエフェクトを処理する（下の capture が例）。特別な印は設けず、この 3 つを名前で定める。
// 標準ライブラリが宣言していても、Fail や Nursery のように実装が言語の中にあるエフェクトは、利用者が処理できる。
//
// resume は継続を表す。resume は第二級（second-class）の値であり、節の外へ持ち出せない
// （変数への束縛、クロージャへの閉じ込め、返り値としての持ち出しは、いずれもできない）。
// そのため、節を抜けた時点で継続が生きているかどうかが確定し、下で述べる自動の巻き戻しが成り立つ。
// resume はアフィンである（呼び出しは高々 1 回）。操作の返り値の型が Unit なら、`resume()` と書ける。
println("test") handle {
  case print(message) => resume(perform write(message))
  case return(x) => x                         // 省略すると `case return(x) => x` と同じになる
}
// この式の型は Unit @ Console である（Print は消え、Console が残る）

// resume の返り値は handle 式全体の型を持つので、出力を集めるハンドラも書ける
let capture[A, E](body: () => A @ {Print extends E}): {value: A, output: String} @ E =
  body() handle {
    case print(message) => {
      let {value, output} = resume()
      {value, output = message + output}
    }
    case return(x) => {value = x, output = ""}
  }

// --- 例外、後始末、キャンセル ---
//
// 専用の例外機構は持たない。resume を呼ばずに節を抜けると、
// 中断した計算の断片を、言語が自動で巻き戻す（後入れ先出し）。
effect Fail = { throw: (String) => Never }

let try_[A, E](body: () => A @ {Fail extends E}): #Ok(A) | #Err(String) @ E =
  body() handle {
    case throw(e)  => #Err(e)                 // resume を呼ばないので、自動で巻き戻る
    case return(x) => #Ok(x)
  }

// defer 構文は持たない。後始末は、ハンドラの `cancel` 節に書く。
// これにより、LIFO の順序、後始末の中で許されるエフェクト、defer と handle の相互作用を、
// すべて「ハンドラの入れ子」の規則で扱える。
//
//   case return(x) => …  正常終了（省略すると x をそのまま返す）
//   case cancel    => …  外側が継続を捨てたことによる巻き戻し（省略すると何もしない）
//
// cancel 節から外へは脱出できない。例外に相当するものが起きるとその cancel 節は打ち切るが、脱出は抑制してログに記録し、外側の後始末を続ける。
// cancel 節は、巻き戻しを起こしているハンドラが外れた文脈で実行する（return 節も同じ）。
// 型付けもこれに合わせ、cancel 節はハンドラの外側の行で型付けする。
// そのため、cancel 節から自分の操作を perform すると、自分の節ではなく、外側にある同名エフェクトのハンドラに届く。
// 届いた先が resume を呼ばずに抜けた場合、その巻き戻しは上の抑制規則に従い、ログに記録されるだけで外へは伝わらない。
// 将来 `case cancel(reason) =>` に拡張できるよう、構文に余地を残してある
// （Go が context.Cause を後から追加したのと同じ需要がある）。
effect File = {
  read:  () => String,
  write: (String) => Unit,
}

// ファイルのプリミティブはランタイムが提供し、行に Fs を加える。純粋な文脈からは呼べない。
//   __open  : (String) => Int32 @ Fs
//   __read  : (Int32) => String @ Fs
//   __write : (Int32, String) => Unit @ Fs
//   __close : (Int32) => Unit @ Fs
// サブエフェクティングがないので、ハンドラの外側の行は、body の行から File を除いたものと一致する。
// with_file 自身が __open と __close で Fs を起こすので、外側の行には Fs が含まれる。そのため、body の行にも Fs を書く。
let with_file[A, E](path: String, body: () => A @ {File, Fs extends E}): A @ {Fs extends E} = {
  let h = __open(path)
  body() handle {
    case read()    => resume(__read(h))
    case write(s)  => resume(__write(h, s))
    case return(x) => { __close(h); x }
    case cancel    => __close(h)
  }
}

// --- with ---
//
// `with x = f(a)` は、`f(a, fn(x) => 残りの文)` の単なる糖衣構文である。
// 束縛側が `_` のときは、引数のない継続 `f(a, fn() => 残りの文)` に脱糖する。
// 「呼び出しの末尾に継続を加える」という 1 つの規則で、defer に相当する処理も、逐次合成も表せる。
// ppx_let の `let%name` のような別の構文は用意しない。
let copy(src: String, dst: String): Unit @ {Console, Fs} = {
  with _ = with_file(src)
  let text = perform read()                   // 最も左の File は src のもの
  with _ = with_file(dst)
  perform write(text)                         // 最も左の File は dst のもの
}

// 逐次合成を必要とするライブラリ（パーサコンビネータなど）も、同じ規則で書ける。
module Parser {
  pub newtype Parser[A] = Parser((String) => Option[{value: A, rest: String}] @ {})
  pub let bind[A, B, E](p: Parser[A], f: (A) => Parser[B] @ E): Parser[B] @ E = ???
  pub let pure[A](x: A): Parser[A] = ???
  pub let token(t: String): Parser[String] = ???
}

let parens(): Parser.Parser[(String, String)] = {
  with x = Parser.bind(Parser.token("("))
  with y = Parser.bind(Parser.token(")"))
  Parser.pure((x, y))
}

// --- エフェクト行に名前を付ける ---
//
// リクエストスコープの値は、Go の context.WithValue ではなく、ハンドラで表す。
// ハンドラは動的スコープとして働き、型が付き、キーが衝突せず、行に現れるので署名から見える。
// 値を引数で引き回さないので、間にある関数には何も書かなくてよい。
effect ReqId  = { req_id: () => String }
effect Logger = { log: (String) => Unit }
effect Tracer = { span: (String) => Unit }

// 実用規模のプログラムでは行が長くなるので、カインド EffectRow のエイリアスでまとめる。
// エイリアスを行の中に書くと、その内容に展開される。
type Request: EffectRow = {ReqId, Logger, Tracer}

pub let handle_request(r: Req): Resp @ {Request, Db, Async} = {
  perform log("handling " + perform req_id())
  Db.query(r.query)
}

// トップレベルに残せるエフェクトは、ランタイムが提供するもの（Console、Async、Fs、Blocking）だけである。
// Heap がこの 4 つに含まれないのは、Heap[h] がリージョン変数を引数に取るラベルであり、トップレベルには渡せる h がないためである。
// h を導入するのは run だけで、run はその Heap[h] を自分で取り除く（§10）。
perform write(capture(fn() => println("test")).output)

// ============================================================
// 10. リージョン（run）
// ============================================================

// `run h { … }` は、rigid なリージョン変数 h（単一化で他の型に置き換わらない変数）を導入し、Heap[h] エフェクトを取り除く。
// h が結果の型に漏れていないことを、脱出検査で確かめる（Koka の st<h> と同じ方式）。
// h のカインドは Type であり、行の位置（`@ h`）には書けない。リージョン専用のカインドは持たない（§14）。
// ランク 2 多相を一般的な機能として持たないので、run を構文として提供する。
// run はハンドラなので、キャンセルされると、リージョンも巻き戻される。
//
// Heap[h] は操作を持たないエフェクトラベルで、Ref と可変配列の操作だけが、これを行に加える。
// 配列は、不変の Array[A] と可変の MutableArray[h, A] に分ける。
// 可変配列はリージョン変数を型に持つので脱出検査が働き、不変配列はリージョンの外へ出してよい。
// その結果、引数を破壊的に更新する関数は、もはや純粋な関数としては型付けされない。
// これにより、§11 の並列処理の決定性と、§13 の「`@` を省略した pub は純粋」という約束を、型検査が保証する。
// 標準ライブラリ側のシグネチャ（`[h, A]` は型パラメータを示す。ここだけの表記で、型式の構文ではない）：
//   Ref.new             : [h, A] (A) => Ref[h, A] @ Heap[h]
//   Ref.get             : [h, A] (Ref[h, A]) => A @ Heap[h]
//   Ref.set             : [h, A] (Ref[h, A], A) => Unit @ Heap[h]
//   Array.length        : [A] (Array[A]) => Int32
//   Array.get           : [A] (Array[A], Int32) => A
//   Array.each          : [A, E] (Array[A], (A) => Unit @ E) => Unit @ E
//   MutableArray.new    : [h, A] (Int32, A) => MutableArray[h, A] @ Heap[h]
//   MutableArray.length : [h, A] (MutableArray[h, A]) => Int32 @ Heap[h]
//   MutableArray.get    : [h, A] (MutableArray[h, A], Int32) => A @ Heap[h]
//   MutableArray.set    : [h, A] (MutableArray[h, A], Int32, A) => Unit @ Heap[h]
//   MutableArray.freeze : [h, A] (MutableArray[h, A]) => Array[A] @ Heap[h]
// 添字が範囲外なら、実行時エラーになる。
// freeze は、可変配列の内容を不変配列として取り出す。freeze の後に元の可変配列へ書き込んでも、
// 取り出した配列は変わらない（これは観測できる契約である。コピーするかどうかは実装が選ぶ）。
// この契約は 1 段だけに適用する。要素そのものが可変配列なら、取り出した配列の要素は、元の可変配列の要素と同じものを指す。
// ただし要素の h は結果の型 Array[MutableArray[h, A]] に残るので、脱出検査がリージョンの外への持ち出しを拒否する。
// length が Heap[h] を要求するのは、長さが変わりうるからではない（長さを変える操作はない）。可変配列に触れること自体を行に記録するためである。
// MutableArray[h, A] は型注釈にも書ける（上の `[h, A]` はパラメータの並びを示す表記で、型式の構文ではない）。
let sum(xs: Array[Int32]): Int32 = run h {
  let acc = Ref.new(0)                        // Ref[h, Int32] @ Heap[h]
  Array.each(xs, fn(x) => Ref.set(acc, Ref.get(acc) + x))
  Ref.get(acc)
}
// sum の型にエフェクト行は現れない。`@` を省略した let なので、純粋な本体の行が行変数として一般化される（§9）。
// 外から見ると純粋で、内部は命令型である。そのため、行変数を `{}` に具体化して、下の par_map に渡せる。
// run が取り除くのは Heap[h] だけなので、他のエフェクトはそのまま外側に残る。

// run の中で組み立てた値を外に出すときは、freeze する
let doubled(xs: Array[Int32]): Array[Int32] = run h {
  let out = MutableArray.new(Array.length(xs), 0)
  let i = Ref.new(0)
  Array.each(xs, fn(x) => {
    MutableArray.set(out, Ref.get(i), x * 2)
    Ref.set(i, Ref.get(i) + 1)
  })
  MutableArray.freeze(out)
}
// 不変配列に set はない。可変配列は型に h を持つので、リージョンの外で作った値を引数として受け取れない。
// 引数の h は run が導入した h とは別のものなので、`run h { MutableArray.set(a, 0, 42) }` の Heap[h] は取り除かれない。

// ============================================================
// 11. 並行性・並列性
// ============================================================

// 並列処理は純粋な計算に限るので、結果は決定的である。
let par_map[A, B](xs: Array[A], f: (A) => B @ {}): Array[B] = ???
let par[A, B](fa: () => A @ {}, fb: () => B @ {}): (A, B) = ???

// 並行処理は、ランタイムが提供するエフェクトで表す。利用者はこれを処理できない（スケジューラを利用者に書かせない）。
//
// yield_ は、キャンセルが届く地点（配送点）である。キャンセルは協調的で、
// 中断点でだけ届く。純粋な長いループは中断できないので、
// Go で ctx.Done() を select するのと同じ要領で、ループの中に yield_ を挟む。
effect Async = { yield_: () => Unit, sleep: (Int64) => Unit }

// スコープは値ではなく、エフェクトで表す。
// Scope 値を引き回す必要がなく、Scope のための脱出検査も要らない
// （行が代わりに保証する）。脱出検査が必要なのは run だけになる。
effect Nursery = { spawn: (() => Unit @ Async) => Unit }

// 正常に抜けるときは、全タスクを join する。異常に抜けるときは、全タスクをキャンセルしてから join する。
// キャンセルは、§9 の自動の巻き戻しがそのまま実装になる（追加の機構は要らない）。
// 子タスクは親より長く生存できない（構造化並行性）。
let scope[A, E](body: () => A @ {Nursery, Async extends E}): A @ {Async extends E} = ???

let serve(cs: List[Conn]): Unit @ Async =
  scope(fn() => each(cs, fn(c) => perform spawn(fn() => handle_client(c))))

// Go の context.Context に相当する型は導入しない。context が担う 4 つの役割は、
// それぞれ既存の機構で実現できる：
//   キャンセルの伝播        → scope の入れ子と自動の巻き戻し
//   デッドライン            → 下の Deadline エフェクトと with_timeout
//   リクエストスコープの値  → ハンドラ（§9 の Request）
//   呼び出し木の構造化      → scope の入れ子
//
// 期限を入れ子にすると、外側の期限が内側の計算を強制的に巻き戻す。そのため、期限の最小値を引き継ぐ動作が、入れ子の構造から得られる。
// 操作が必要になるのは、残り時間を読みたい場合（ソケットのタイムアウト設定や、処理を打ち切る判断）だけである。
effect Deadline = { deadline: () => Option[Instant] }

let with_timeout[A, E](
  ms: Int64,
  body: () => A @ {Deadline extends E},
): Option[A] @ {Async extends E} = ???

// リクエストより長く生存してよいタスク（監査ログ、キャッシュのウォームアップ、メトリクスのフラッシュ）は、
// 外側の nursery を名前で指定する。context.Background() と違って署名に現れるので、
// 「このハンドラは、リクエストより長く生存するタスクを作る」ことが型から分かる。
effect Background = { spawn_bg: (() => Unit @ Async) => Unit }

pub let handle_audited(r: Req): Resp @ {Request, Db, Background, Async} = {
  let resp = handle_request(r)
  perform spawn_bg(fn() => audit_log(r, resp))
  resp
}

// 長い計算の途中でもキャンセルできるようにする例
let crunch(xs: Array[Int32]): Int32 @ Async = run h {
  let acc = Ref.new(0)
  Array.each(xs, fn(x) => {
    perform yield_()                          // キャンセルの配送点
    Ref.set(acc, Ref.get(acc) + heavy(x))
  })
  Ref.get(acc)
}

// run のヒープハンドルはタスクの境界を越えられないので、タスク間で共有する可変状態は存在しない。
// そのため、仕様にメモリモデルを書く必要がなく、アトミック操作もロックも要らない。タスク間の通信にはチャネルを使う。
let channel[A](capacity: Int32): Chan[A] = ???
let send[A](c: Chan[A], x: A): Unit @ Async = ???
let recv[A](c: Chan[A]): A @ Async = ???

// ============================================================
// 12. FFI
// ============================================================

extern "C" let sin(x: Float64): Float64                  // ブロックしない
extern "C" let sqlite_step(s: Stmt): Int32 @ Blocking    // ブロックすることがある

// 関数がブロックするかどうかを知っているのはバインディングの作者なので、印は宣言側に付ける。
// 行多相により、この印は呼び出し元の署名へ自動的に伝わる。
//
// 仕様には観測できる契約だけを書き、実装戦略は書かない：
//   「Blocking 領域の実行は、他のタスクが利用できる並列度を
//     （実装定義の上限まで）減らさない」
//
// Blocking は、ランタイムが実装を持つ、操作のないエフェクトラベルである。
// 操作を持たないラベル（Heap、Blocking、Fs）は、どれも宣言が要らない。標準ライブラリが同じ宣言を持つ場合は、
// 利用者が同じ宣言をもう一度書いてもよい（§9 のエフェクト宣言の並びにある `effect Fs = {}` がその例である。
// 構造が異なる再宣言は拒否する）。
// Blocking はトップレベルに残してよく、下の pinned で取り除くこともできる。
// Blocking 領域はキャンセルの配送点ではない（ネイティブコードは中断できない）。
// pinned はタスクを専用のスレッドに固定する。スレッド親和性のあるライブラリには必須である。
let pinned[A, E](body: () => A @ {Blocking extends E}): A @ E = ???

// ============================================================
// 13. モジュールと可視性
// ============================================================

// pub を付けた宣言だけが、パッケージの外に公開される。
// pub を付けるには、型注釈が完全でなければならない。入れ子の矢印の `@` も省略できない。
// 省略した場合の意味（`@ {}`）は決まっている。しかし公開 API では、純粋を意図したのか書き忘れたのかを、
// 読み手が区別できる必要がある。
// この要求は、pub newtype のフィールドに現れる矢印にも適用する（§9 の Parser が例）。
// フィールドの型は、公開されるコンストラクタの引数型だからである。
// 最外の矢印のエフェクト行を省略した場合は、推論に任せず、「本体は純粋でなければならず、
// 公開される型は行多相」と読む（§9）。呼び出し側は、どの行の下からでも呼べる。
// これは、実装を変えたはずみに公開 API のエフェクト行が変わり、下流のコードが壊れるのを防ぐためである。
// newtype の型名とコンストラクタは可視性を共有する。pub なら両方を公開し、pub でなければ両方を隠す。
// 型名だけを公開して表現を隠す手段は、まだない（§14）。
// 標準ライブラリが持つ修飾名（§10 の Ref、Array、MutableArray の操作と、§8 の型クラスのメソッド）と同じ綴りの修飾名は、
// module 宣言で作れない。黙って覆い隠すと組み込み側の署名が使えなくなり、診断も原因から遠い位置に出るためである。
// module 名そのものは予約しない。module Array { pub let sum(…) } のように、組み込みにない名前を追加するのは構わない。
module BigInt {
  pub newtype BigInt = ???                    // `???` は未実装を表す穴
  pub let parse(str: String): BigInt = ???    // 省略すると、本体は純粋で、公開される型は行多相
  let normalize(x: BigInt): BigInt = ???      // pub なし。注釈は自由に書ける

  // インスタンスは常に大域的に見える。pub は書かない
  type instance Add[BigInt] { let add(x, y) = ??? }
  type instance Mul[BigInt] { let mul(x, y) = ??? }
}

type MyBigInt = BigInt  // コンパニオン型（モジュールと同名の型は、モジュール名だけで参照できる）

let big_sum(): MyBigInt = BigInt.parse("123") + BigInt.parse("456")

// ============================================================
// 14. 未決定事項
// ============================================================

// TODO: spawn に渡すタスクの行を、どこまで多相にできるか。
//       エフェクト宣言の操作型は固定なので、`() => Unit @ Async` としか書けない。
//       本来は、spawn する地点で使えるエフェクト（Nursery を除く）をそのまま使いたい。
//       操作型が周囲の行を参照できる仕組みが必要かもしれない。
//       §9 の注釈の規則（入れ子の矢印に書いた行はそのまま読む）は、effect の操作型にも適用する。
//       そのため、Nursery の `@ Async` が暗黙に開かれて多相になることはなく、この TODO は別途決める必要がある。
// TODO: Nursery を入れ子にしたとき、perform spawn は内側の Nursery に届く。
//       外側を指定する手段（Background のように名前で分ける方法以外）が必要か。
// TODO: 導出規則をマクロで書けるようにする構文。
// TODO: import の構文（現状は完全修飾名による参照だけ）。
// TODO: newtype の表現をパッケージ内で隠す手段。pub だけでは、モジュール境界で抽象化できない。
// TODO: Chan の標準ライブラリ側のシグネチャ。§11 の channel、send、recv は署名の形しか示していない。
// TODO: モジュールの入れ子。名前解決と可視性の規則（外側の pub でない束縛が内側から見えるか）が未定である。
// TODO: Ord[Float64]、Eq[Float64] と NaN。IEEE 754 に従うと、eq、lt、le、gt、ge は NaN を含むと偽になる。
//       その結果、Ord は全順序でなくなり、Eq は同値関係でなくなる（どちらも反射律が成り立たない）。
//       derive structural の Eq も同様で、Float64 のフィールドを 1 つ持つだけで、レコードの Eq が反射律を失う。
//       全順序と同値関係が必要な場面をどう書くかは未定で、将来の課題とする。案は 2 つある。
//       (1) newtype で包んだ TotalFloat64 だけが Ord と Eq を実装する（§6 の TotalFloat64 はこの案の例）。
//       (2) Ord とは別に、全順序の compare を用意する（Julia の isless に近い。以前の自作言語ではこちらを採用した）。
// TODO: 非有限値（NaN、無限大）のリテラルを追加するか。現状は、文字列化した表記 `nan`、`inf` を読み戻せない。
// TODO: 整数算術の桁あふれ。現状は折り返すが、実行時エラーにする案も残っている（§2）。
// TODO: 不変配列を作る手段。現状は MutableArray.freeze だけで、リテラルも Array.new もない（§10）。
// TODO: リージョンに専用のカインド（Region）を導入するか。現状の h はカインド Type なので、
//       値の型の位置に `h` と書けてしまう（その型の値を作る手段はないので、実行時の問題にはならない）。
// TODO: pub でない let で、「本体は純粋、呼び出しはどの行からでも可」を注釈で書く手段。
//       現状は、`@ {}` を書くと呼び出し側の行も空に制限され、省略すると推論になる（§9）。
// TODO: 型パラメータのカインドを注記する構文。エイリアスには `type Request: EffectRow` があるが（§1、§9）、
//       型パラメータにはなく、カインドは宣言群の中の型の本体での使われ方からしか決まらない（§6）。
//       使われ方のないパラメータは Type に既定化されるので、行カインドの幽霊型パラメータ（phantom）は書けない。
