; DIKTOR_VIA_IR=1 は、モードのオプションも KIR のオプションも付けない実行を KIR の経路に切り替える。
; dune は環境変数を依存として追跡しないので、ここに明示する。
; 明示しないと、DIKTOR_VIA_IR=1 で実行した結果を、通常の runtest が再利用する。

(cram
 (deps
  %{bin:diktor}
  (env_var DIKTOR_VIA_IR)
  (glob_files sample/*.kel)))

; cram のテスト全体を、KIR の経路(DIKTOR_VIA_IR=1)で実行し直す。
; via-ir-exclude.txt に載せたコマンドだけは、構文木の評価器で実行する。
; dune の cram はコマンド単位で除外できないので、via_ir_run.py が cram と同じ形式で実行する。

(rule
 (alias runtest-via-ir)
 (deps
  via_ir_run.py
  via-ir-exclude.txt
  %{bin:diktor}
  (env_var DIKTOR_VIA_IR)
  (glob_files *.t)
  (glob_files sample/*.kel))
 (action
  (run python3 via_ir_run.py --diktor %{bin:diktor} --exclude via-ir-exclude.txt)))
